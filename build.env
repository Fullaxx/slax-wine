# slax-wine build configuration -- the single source of truth for release identity.
#
# Sourced by build.sh and ci/checks/96-release-consistency.sh. Plain POSIX sh
# assignments: no command substitution, no expansion, so it is safe to source and
# cheap to parse with sed from a gate.
#
# A release is defined by BOTH halves -- our VERSION and the exact base ISO it was
# built on. Changing either is a version bump. The git tag must be v$VERSION; gate 96
# refuses a tagged HEAD where it is not.

VERSION=1.0.0

# ---- the base images ---------------------------------------------------------------
# Each BASE*_TARGET must name a target in vendor/slax-kitchen/compat/sources.yaml, and
# its _SHA256 and _SIZE must match that entry. Gate 96 cross-checks both bases, which is
# what catches a submodule bump that silently changes which ISO we build on. `kitchen
# fetch --verify-only` then re-checks the bytes on every build.
#
# BASE32_* builds slax32-wine-bios and -uefi. BASE64_* builds slax64-wine-bios and -uefi,
# and slax-bottles.
BASE32_TARGET=debian-32bit-12.2.0
BASE32_FLAVOUR=debian
BASE32_ARCH=32bit
BASE32_VERSION=12.2.0
BASE32_ISO=slax-32bit-debian-12.2.0.iso
BASE32_SHA256=03b85cd259883f6781b3a3f30ed409b0b6a542b8f510094594c7600bd94e546b
BASE32_SIZE=436060160

BASE64_TARGET=debian-64bit-12.2.0
BASE64_FLAVOUR=debian
BASE64_ARCH=64bit
BASE64_VERSION=12.2.0
BASE64_ISO=slax-64bit-debian-12.2.0.iso
BASE64_SHA256=61d9fdcc006938d6fd6f231e22d8af926ae8f48fdf0487b8010e69f3bd17cf70
BASE64_SIZE=435853312

# ---- the application layer: Notepad++, 32- and 64-bit --------------------------------
# One Notepad++ release supplies both installers, so APP_VERSION is shared. Updating
# Notepad++ is SEVEN edits here: APP_VERSION, then APP32_URL, APP32_SHA256 and APP32_SIZE
# for the x86 installer, and APP64_URL, APP64_SHA256 and APP64_SIZE for the x64 one. Each
# is staged under a stable filename (npp32-installer.exe, npp64-installer.exe), so nothing
# outside this file has to change -- not a recipe, not a wrapper, not a .desktop entry.
#
# APP_VERSION is not decorative, and leaving it behind is not cosmetic: build.sh writes
# it into /opt/notepadpp32/VERSION and /opt/notepadpp64/VERSION INSIDE THE ISO and into
# the build summaries, so a stale value ships an image that misreports its own
# application version. Gate 96 section 2b cross-checks APP_VERSION against both URLs,
# because each carries the version twice and an instruction nothing enforces is a
# suggestion.
#
# The NSIS installers rather than the portable trees, deliberately: a portable .exe
# proves only that Wine can load a PE binary, while an installer also exercises the NSIS
# runtime, registry writes, file creation in the prefix and shortcut generation.
#
# APP32 is the x86 installer, PE32/i386, which installs x86 binaries: it runs under
# wine32 on both bases (notepadpp32.yaml). APP64 is the x64 installer, and MEASURED, it is
# PE32/i386 too -- an NSIS stub -- but what it installs is x86-64, which only wine64 runs,
# so it ships on the 64-bit base only (notepadpp64.yaml).
#
# Both SHA256 values are upstream's own published ones -- they appear verbatim in
# npp.8.9.8.checksums.sha256, which Notepad++ also signs.
#
# The two _SIZE values are read by nothing today -- each BASE*_SIZE is used twice, and
# the asymmetry once read as a guarantee that did not exist. Kept because `kitchen fetch`
# verifies size+sha256 for the bases and these are the same fact for the apps: if
# build.sh ever grows a size check on the payloads, these are the values it must use.
APP_VERSION=8.9.8
APP32_URL=https://github.com/notepad-plus-plus/notepad-plus-plus/releases/download/v8.9.8/npp.8.9.8.Installer.exe
APP32_SHA256=9753e2eba8f0ff056d60c52a917f7760ea81227e41b1786260e1ac76db398434
APP32_SIZE=6806520
APP64_URL=https://github.com/notepad-plus-plus/notepad-plus-plus/releases/download/v8.9.8/npp.8.9.8.Installer.x64.exe
APP64_SHA256=7b2a949bf460fb37a3888c9048698f43222a185a48323023df1c51e78a3ca1c2
APP64_SIZE=6953384

# ---- guard rails -------------------------------------------------------------------
# A runaway apt closure is otherwise invisible until somebody downloads the result. Each
# cap is a measured image + 5%, and covers both of its architecture's images: the bios
# one is 6.2 MiB smaller than the uefi one, which is well inside the 5%.
#
# slax32-wine: 507.3 MiB (bios) and 513.5 MiB (uefi), measured on the first build; the
# cap is the bios image + 5%.
WINE32_MAX_ISO_MIB=532
# slax64-wine: 815.6 MiB (bios) and 821.7 MiB (uefi), measured on the first build; the
# cap is the uefi image + 5%.
WINE64_MAX_ISO_MIB=862

# ---- slax-bottles -------------------------------------------------------------------
# Bottles ships only as a Flatpak, and Flathub builds it for x86_64 only, so slax-bottles
# is built on BASE64_* (docs/DECISIONS.md D-14).

# ---- the Bottles payload ----------------------------------------------------------
# Installed from Flathub by build.sh into recipes/available/bottles.files/, then copied
# into 30-bottles.sb by bottles.yaml. The pin is BOTTLES_LOCK: every ref the install
# pulls in, with the ostree commit that shipped. build.sh installs, forces each ref to
# its locked commit with `flatpak update --commit`, and then refuses to continue unless
# `flatpak info --show-commit` agrees for every line. A ref it installed that is NOT in
# the lock fails the build too, because an unlisted runtime is an unpinned one.
#
# Updating Bottles: delete recipes/available/bottles.files/, run build.sh with
# BOTTLES_RELOCK=1, and it prints a fresh lock to paste here. Then update BOTTLES_VERSION
# here and the BOTTLES_VERSION= line in bottles.yaml's /etc/slax-bottles-release; gate 96
# checks those two agree, and build.sh checks BOTTLES_VERSION against the locked commit.
#
# Flathub does not keep every old commit forever. When a locked commit can no longer be
# fetched, the build FAILS and says so. It never quietly takes whatever is current.
#
# Pinned 2026-09-18 from Flathub stable. Runtime: org.gnome.Platform//50 on
# freedesktop 25.08. The .Locale refs are partial installs: BOTTLES_LANGUAGES below picks
# the subset, and build.sh checks both the setting and what is actually deployed.
BOTTLES_APP=com.usebottles.bottles
BOTTLES_BRANCH=stable
BOTTLES_VERSION=67.3
BOTTLES_LOCK="
  app/com.usebottles.bottles/x86_64/stable b63354d6e95377f11796244da517df58866c708aeab2b13cf81082ba5a14c1dd
  runtime/com.usebottles.bottles.Locale/x86_64/stable 9248b40932a8e175badcd996a1acc9d6882720aebab9b61bc66dfb77566dd192
  runtime/org.freedesktop.Platform.codecs_extra.i386/x86_64/25.08-extra 05e1b738969ef54d2ab8175e20ed32466dbe36c59d76ab07035e154bbdf0a09b
  runtime/org.freedesktop.Platform.codecs-extra/x86_64/25.08-extra 7ccd63f7532e93ce345b67dedc492748bba449917e81a031502715bc38e3f438
  runtime/org.freedesktop.Platform.Compat.i386/x86_64/25.08 10c43710cbba7c67183615a06816d8b5a6ef4a079478c9484e9550a1d438241f
  runtime/org.freedesktop.Platform.GL32.default/x86_64/25.08 7e1d4739a4c4f25468727c89669b18f1318064a8f9213697f38b802e2f64c114
  runtime/org.freedesktop.Platform.GL32.default/x86_64/25.08-extra 76a9cd931f75f63351ebbe201eef7429d7e699582c6c40d80d033605988bc496
  runtime/org.freedesktop.Platform.GL.default/x86_64/25.08 0083f33e9a33c454d0f0850d06581e5f991ecf2dbde02e38079db49e01c7ebac
  runtime/org.freedesktop.Platform.GL.default/x86_64/25.08-extra 695a049fc6520a9c8041cbdb35df59f9d38b562b02c6316a36fb2deb50a0992b
  runtime/org.gnome.Platform.Locale/x86_64/50 3ac45ed3d863cd2501df183efda0238f18bfe96d7ea803ba88511118d9aa312f
  runtime/org.gnome.Platform/x86_64/50 fc150bcbb560aebb920738976c963cbdb7f83498d583221dadd942870b1bf307
  runtime/org.winehq.Wine.gecko/x86_64/stable-25.08 2352cf299f4768999d29478d0fb55e5070d88f868ed69f7581e3b128d675e030
  runtime/org.winehq.Wine.mono/x86_64/stable-25.08 d45c459cdfecee8fe71e239e973f1e700f811dfd0385c20b4709157cb2e4c321
"
# ---- Bottles' components: DXVK and VKD3D -------------------------------------------
# MEASURED, not assumed: offline, `bottles-cli new` FAILS with "Missing essential
# components ... Fail to install components, tried 3 times" even though the Flatpak
# already carries a runner (sys-wine-11.0). manager.py's components_check treats a
# runner, a DXVK and a VKD3D as essential, and it finds the last two by listing
# ~/.var/app/com.usebottles.bottles/data/bottles/{dxvk,vkd3d}/. build.sh fetches these
# two, checks their sha256, and unpacks them there; bottles.yaml ships the result.
#
# One line per component: category, name, URL, sha256. The URLs are the ones Bottles'
# own components index names, at the commit Bottles 67.3 pins
# (bottlesdevs/components f63f670), taking the newest STABLE entry of each. That index
# publishes md5 only. These sha256 values were taken from files whose md5 matched it.
BOTTLES_COMPONENTS="
  dxvk dxvk-3.1 https://github.com/doitsujin/dxvk/releases/download/v3.1/dxvk-3.1.tar.gz 30f9cc326874be344285582275446968cfa4c069db31ce56df312d6644179154
  vkd3d vkd3d-proton-3.0.1 https://github.com/bottlesdevs/components/releases/download/vkd3d-proton-3.0.1/vkd3d-proton-3.0.1.tar.gz 171f4bf95cb9eaea5249cd3f2211e602d971a292a72c462ec293449112b673f3
"

# The locale subset flatpak deploys. Fixed rather than inherited from the build host's
# locale, so two hosts produce the same tree.
BOTTLES_LANGUAGES=en

# ---- guard rail -------------------------------------------------------------------
# Kept separate from the WINE caps: this image is the 1.2 GiB one. Measured 1241.7 MiB
# (1,302,048,768 bytes) once DXVK/VKD3D were added; set to that + 5%. The 2026-09-21 build
# came to 1240.4 MiB from the same tree -- a Flatpak stage is not byte-stable across
# installs (docs/sizing.md) -- so the cap stays where it is rather than tracking a build.
BOTTLES_MAX_ISO_MIB=1304
